# ── Ambiente ────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ── Provider padrão ─────────────────────────────────────
DEFAULT_PROVIDER=azure

# ── Azure AI Foundry ───────────────────────────────────
# Endpoint do recurso Azure AI Foundry (inclui /openai/v1)
AZURE_AI_ENDPOINT=https://tino-resource.services.ai.azure.com/openai/v1

# Nome do deployment no Azure (ex: gpt-5.6-sol)
AZURE_AI_DEPLOYMENT_NAME=gpt-5.6-sol
AZURE_AI_DEFAULT_MODEL=gpt-5.6-sol

# Lista de modelos/deployments separados por vírgula (opcional)
# AZURE_AI_MODELS=gpt-5.6-sol,gpt-4o,o3

# Versão da API do Azure OpenAI
AZURE_AI_API_VERSION=2024-10-21

# Escopo do token (raramente alterado)
AZURE_AI_TOKEN_SCOPE=https://ai.azure.com/.default

# ⚠️ NOTA: A autenticação usa DefaultAzureCredential.
# Não é necessário informar AZURE_AI_API_KEY manualmente.
# O Azure encontra credenciais automaticamente via:
#   - AZURE_TENANT_ID + AZURE_CLIENT_ID + AZURE_CLIENT_SECRET
#   - ou az login (CLI)
#   - ou Managed Identity (em produção no Azure)
#
# Para autenticar com service principal, defina:
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# ── Futuros provedores (deixe em branco se não usar) ───
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OLLAMA_BASE_URL=
# OPENROUTER_API_KEY=
