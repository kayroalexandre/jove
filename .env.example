# ── Ambiente ────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ── Provider padrão ─────────────────────────────────────
DEFAULT_PROVIDER=azure

# ── Azure AI Foundry ───────────────────────────────────
AZURE_AI_ENDPOINT=
AZURE_AI_API_KEY=
AZURE_AI_API_VERSION=2024-10-21
AZURE_AI_DEFAULT_MODEL=

