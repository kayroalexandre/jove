{
  "name": "jove",
  "version": "0.1.0",
  "private": true,
  "description": "Gateway local compatível com a API da OpenAI para Azure AI Foundry e outros provedores.",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter @jove/gateway dev",
    "build": "bun run --filter '*' build",
    "test": "bun run --filter @jove/core test && bun run --filter @jove/openai-api test && bun run --filter @jove/gateway test",
    "lint": "bun run --filter '*' lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.base.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.20.0",
    "vitest": "^2.1.0",
    "eslint": "^9.18.0",
    "prettier": "^3.4.0"
  },
  "engines": {
    "node": ">=22"
  }
}
